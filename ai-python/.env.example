# LifelineAI Environment Variables
# Copy this file to .env and fill in your actual API keys

# Groq AI API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Backend Configuration  
BACKEND_BASE_URL=http://localhost:8080/api

# Foxit PDF API Configuration (optional - for PDF generation)
FOXIT_CLIENT_ID=your_foxit_client_id_here
FOXIT_CLIENT_SECRET=your_foxit_client_secret_here

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO